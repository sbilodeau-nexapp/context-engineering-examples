        <!--        >-->
        <!--          Reset your password-->
        <!--        </mj-button>-->

        <mj-text font-size="15px" line-height="1.5">
          <p>If you didn't request this reset, please disregard this email.</p>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
