<mjml>
  <mj-body>
    <mj-section>
      <mj-column width="30%">
        <mj-image src="https://www.nexapp.ca/hubfs/Logo.svg" align="left" />
      </mj-column>
    </mj-section>

    <mj-section>
      <mj-column>
        <mj-text font-size="15px" line-height="1.5">
          <p>Hello,</p>

          <p>We received a password reset request for your account.</p>

          <p>Your verification code is: {####}</p>

          <p>
            This code is valid for 1 hour. After this time, you'll need to
            submit a new request.
          </p>
        </mj-text>

